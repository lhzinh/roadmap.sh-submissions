        "description": "verify table \"category\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"category\""
        ]
      }
    ]
  },
  {
    "id": "unique.category.category_name_key",
    "label": "Add unique constraint on \"category\" (name)",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "unique",
        "name": "category_name_key",
        "table": "category"
      }
    },
    "precheck": [
      {
        "description": "ensure constraint \"category_name_key\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "category_name_key",
          "public",
          "\"public\".\"category\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add unique constraint \"category_name_key\"",
        "sql": "ALTER TABLE \"public\".\"category\" ADD CONSTRAINT \"category_name_key\" UNIQUE (\"name\")"
      }
    ],
    "postcheck": [
      {
        "description": "verify constraint \"category_name_key\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "category_name_key",
          "public",
          "\"public\".\"category\""
        ]
      }
    ]
  }
