{
  "name": "ecommerce-api",
  "private": true,
  "packageManager": "bun@1.4.1",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "contract:infer": "prisma contract infer --output ./src/prisma/contract.prisma",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:seed": "tsx ./src/prisma/seed.ts",
    "dev": "bun ./src/server.ts",
    "migrate": "prisma db migrate --advance-ref db",
    "migration:plan": "prisma migration plan",
    "migration:status": "prisma migration status"
  },
  "dependencies": {
    "@adminjs/express": "^6.1.1",
    "@prisma/orm-postgres": "^8.0.0-rc.11",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "add": "^2.0.9",
    "adminjs": "^7.8.17",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-formidable": "^1.2.0",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "tslib": "^2.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@prisma/dev": "0.25.2",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "prisma": "^8.0.0-rc.15",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "effect": "4.0.0-rc.112"
  }
}
